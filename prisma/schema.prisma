generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  category  String
  published Boolean  @default(false)
  imageUrl  String?
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String
  category    String
  featured    Boolean  @default(false)
  imageUrl    String?
  githubUrl   String?
  liveUrl     String?
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Education {
  id          String   @id @default(cuid())
  year        String
  title       String
  subtitle    String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Experience {
  id          String   @id @default(cuid())
  year        String
  title       String
  subtitle    String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Skill {
  id          String   @id @default(cuid())
  category    String
  items       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model HomeHighlight {
  id        String   @id @default(cuid())
  icon      String
  title     String
  desc      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AboutValue {
  id        String   @id @default(cuid())
  icon      String
  title     String
  desc      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AboutLeadershipItem {
  id        String   @id @default(cuid())
  title     String
  desc      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ResumeCertification {
  id        String   @id @default(cuid())
  title     String
  desc      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model NavigationLink {
  id        String   @id @default(cuid())
  location  String   // "navbar" | "footer"
  href      String
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactItem {
  id        String   @id @default(cuid())
  location  String   // "contact" | "footer"
  icon      String   // "map" | "mail" | "phone" etc.
  label     String
  value     String
  href      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
